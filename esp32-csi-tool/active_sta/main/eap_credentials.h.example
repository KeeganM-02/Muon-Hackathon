/* Copy to eap_credentials.h (git-ignored) and fill in your eduroam details.
 *
 *   cp eap_credentials.h.example eap_credentials.h
 *
 * These macros override the menuconfig values, so the password never has to
 * live in sdkconfig.
 *
 * EAP_IDENTITY is sent in the clear before the TLS tunnel. Many institutions
 * expect anonymous@your.institution there; others accept the username.
 * EAP_USERNAME is the inner (tunneled) identity, usually user@institution.edu.
 */
#define EAP_IDENTITY "anonymous@institution.edu"
#define EAP_USERNAME "user@institution.edu"
#define EAP_PASSWORD "your-eduroam-password"
