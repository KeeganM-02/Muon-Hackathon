# FreeWili bench setup for active_sta: connect to eduroam with PEAP/MSCHAPv2
# and print CSI on the same UART0 the espuart app reads (3 Mbaud, GPIO16 TX).
# The EAP secrets are deliberately empty here -- fill them in with
# `idf.py menuconfig` or main/eap_credentials.h, never in this file.
CONFIG_ESP_WIFI_SSID="eduroam"
CONFIG_ESP_WIFI_ENTERPRISE=y
CONFIG_ESP_EAP_IDENTITY=""
CONFIG_ESP_EAP_USERNAME=""
CONFIG_ESP_EAP_PASSWORD=""

CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_SHOULD_COLLECT_CSI=y
CONFIG_SHOULD_COLLECT_ONLY_LLTF=y
CONFIG_SEND_CSI_TO_SERIAL=y

CONFIG_PACKET_RATE=2

CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=16
CONFIG_ESP_CONSOLE_UART_RX_GPIO=17
CONFIG_ESP_CONSOLE_UART_BAUDRATE=3000000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
